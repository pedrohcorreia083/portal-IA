APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Serviço de identificação de peças por imagem (Flask + PyTorch)
FLASK_API_URL=http://localhost:9059

# Diretório da biblioteca de imagens de produto.
# Em produção: /home/ftpuser/ftp/upload
UPLOADS_BASE_PATH=

# Credenciais iniciais do administrador usadas por "php artisan db:seed".
# Se ADMIN_PASSWORD ficar vazio, o seeder gera uma senha aleatória e a exibe uma única vez.
ADMIN_EMAIL=admin@lbfportal.com
ADMIN_PASSWORD=
